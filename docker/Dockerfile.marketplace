# Multi-stage Dockerfile for Automotive OS Marketplace Frontend
FROM node:20-alpine AS base
WORKDIR /app
RUN npm install -g pnpm@9.15.9

FROM base AS dependencies
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/marketplace/package.json ./apps/marketplace/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/ui/package.json ./packages/ui/
COPY packages/config/package.json ./packages/config/
RUN pnpm install --frozen-lockfile

FROM dependencies AS builder
WORKDIR /app
COPY . .
RUN pnpm --filter @automotive-os/contracts run build
RUN pnpm --filter @automotive-os/ui run build
RUN pnpm --filter marketplace run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=staging
ENV PORT=3000
RUN apk add --no-cache curl

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
USER nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/marketplace/.next ./apps/marketplace/.next
COPY --from=builder --chown=nextjs:nodejs /app/apps/marketplace/public ./apps/marketplace/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/marketplace/package.json ./apps/marketplace/package.json
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/packages ./packages

EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:3000/api/health || exit 1

CMD ["node_modules/.bin/next", "start", "apps/marketplace", "-p", "3000"]
