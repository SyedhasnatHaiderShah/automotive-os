# Multi-stage Dockerfile for Automotive OS Dealer Cockpit Frontend
FROM node:20-alpine AS base
WORKDIR /app
RUN npm install -g pnpm@9.15.9

FROM base AS dependencies
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/dealer/package.json ./apps/dealer/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/ui/package.json ./packages/ui/
COPY packages/config/package.json ./packages/config/
RUN pnpm install --frozen-lockfile

FROM dependencies AS builder
WORKDIR /app
COPY . .
RUN pnpm --filter @automotive-os/contracts run build
RUN pnpm --filter @automotive-os/ui run build
RUN pnpm --filter dealer run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=staging
ENV PORT=3001
RUN apk add --no-cache curl

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
USER nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/dealer/.next ./apps/dealer/.next
COPY --from=builder --chown=nextjs:nodejs /app/apps/dealer/public ./apps/dealer/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/dealer/package.json ./apps/dealer/package.json
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/packages ./packages

EXPOSE 3001
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:3001/api/health || exit 1

CMD ["node_modules/.bin/next", "start", "apps/dealer", "-p", "3001"]
