# Environment configuration template for Automotive OS

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/automotive_os?schema=public"

# Cache & Queues (Redis 7)
REDIS_URL="redis://localhost:6379"

# API Service
API_PORT=4000
API_HOST="http://localhost:4000"
NODE_ENV="development"

# Auth / JWT (Development fallback - replace in production)
JWT_SECRET="dev-jwt-secret-replace-in-production-min-32-chars-long"

# Frontend Application URLs
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_MARKETPLACE_URL="http://localhost:3000"
NEXT_PUBLIC_DEALER_URL="http://localhost:3001"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"

# S3 / Object Storage (Private Vehicle Inspection and Media)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="me-central-1"
S3_BUCKET="automotive-os-media"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# Public media URLs: CDN base if one serves the bucket; otherwise media is
# served via the API proxy /api/v1/public/media/*, prefixed with PUBLIC_API_URL
# (leave empty to emit origin-relative URLs through the marketplace /api rewrite).
S3_PUBLIC_CDN_URL=
PUBLIC_API_URL=
