{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://cars-staging.syedhasnat.com",
          "https://dealer-staging.syedhasnat.com"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "Content-Type",
          "Range"
        ]
      },
      "exposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Range"
      ],
      "maxAgeSeconds": 86400
    }
  ]
}
