{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://dealer-staging.syedhasnat.com",
          "https://admin-staging.syedhasnat.com"
        ],
        "methods": [
          "PUT",
          "GET",
          "HEAD"
        ],
        "headers": [
          "Content-Type",
          "Content-MD5",
          "x-amz-server-side-encryption",
          "x-amz-user-agent"
        ]
      },
      "exposed": {
        "headers": [
          "ETag"
        ]
      },
      "maxAgeSeconds": 3600
    }
  ]
}
