{
  "$schema": "https://developers.cloudflare.com/cloudflare-one/policies/access/",
  "version": "2026-10-23",
  "application": {
    "name": "Automotive OS — Platform Admin Staging",
    "domain": "admin.staging.automotive-os.ae",
    "type": "self_hosted",
    "session_duration": "12h",
    "auto_redirect_to_identity": true,
    "enable_binding_cookie": true,
    "http_only_cookie_attribute": true,
    "same_site_cookie_attribute": "strict"
  },
  "policies": [
    {
      "name": "Enforce Platform Staff MFA & UAE Geo-fencing",
      "decision": "allow",
      "include": [
        {
          "email_domain": {
            "domain": "automotive-os.ae"
          }
        }
      ],
      "require": [
        {
          "geo": {
            "country_code": "AE"
          }
        },
        {
          "login_method": {
            "require_mfa": true
          }
        }
      ]
    },
    {
      "name": "Deny High Risk & Non-Compliant Traffic",
      "decision": "deny",
      "include": [
        {
          "everyone": true
        }
      ],
      "require": [
        {
          "threat_score": {
            "operator": "greater_than",
            "score": 30
          }
        }
      ]
    }
  ]
}
