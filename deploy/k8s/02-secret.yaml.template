apiVersion: v1
kind: Secret
metadata:
  name: automotive-os-staging-secrets
  namespace: automotive-os-staging
type: Opaque
stringData:
  DATABASE_URL: "postgresql://automotive_app:STAGING_APP_PASSWORD@postgres-service.automotive-os-staging.svc.cluster.local:5432/automotive_os?schema=public&sslmode=prefer"
  DIRECT_URL: "postgresql://postgres:STAGING_SUPERUSER_PASSWORD@postgres-service.automotive-os-staging.svc.cluster.local:5432/automotive_os?schema=public&sslmode=prefer"
  REDIS_URL: "redis://redis-service.automotive-os-staging.svc.cluster.local:6379"
  JWT_SECRET: "STAGING_CRYPTOGRAPHIC_JWT_SECRET_MIN_64_CHARS"
  JWT_EXPIRATION: "24h"
  POSTGRES_USER: "postgres"
  POSTGRES_PASSWORD: "STAGING_SUPERUSER_PASSWORD"
  POSTGRES_DB: "automotive_os"
