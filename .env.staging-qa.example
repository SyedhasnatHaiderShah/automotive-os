# Copy to .env.staging-qa.local (gitignored) and fill from Railway.
# Used only by apps/api/scripts/staging-qa/* and `prisma migrate deploy` for staging QA.

# Postgres OWNER connection: Postgres service -> Variables -> DATABASE_PUBLIC_URL.
DATABASE_URL=

# Staging object storage: automotive-api service -> Variables (same names).
# R2_* names are also accepted.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=
