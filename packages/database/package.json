{
  "name": "@automotive-os/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "init:role": "tsx scripts/init-app-role.ts",
    "apply:policies": "tsx scripts/apply-tenant-policies.ts",
    "seed": "tsx prisma/seed.ts",
    "verify:backup": "tsx scripts/verify-backup-snapshot.ts",
    "verify:rls": "tsx scripts/verify-rls-post-migration.ts",
    "build": "prisma generate && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"database lint passed\"",
    "test": "tsx test/rls-isolation.test.ts && tsx test/backup-and-rls-verification.test.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aws-sdk/client-rds": "^3.758.0",
    "@prisma/client": "^6.4.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@automotive-os/config": "workspace:*",
    "@types/pg": "^8.11.11",
    "pg": "^8.13.1",
    "prisma": "^6.4.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
